{
	"id": "wmshop",
	"org": "wallmoney",
	"repo": "plugin-shop",
	"name": "wallmoney-shop",
	"displayName": "Wall Money Shop",
	"description": "Run an ecommerce storefront with IPFS-hosted listings, categories, cart, saved delivery details, and Wall Money checkout.",
	"version": "0.1.0",
	"license": "MIT",
	"main": "dist/plugin.js",
	"exports": "./dist/plugin.js",
	"files": [
		"dist/plugin.js",
		"icon.svg",
		"README.md",
		"package.json"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite dev",
		"build:catalog": "node scripts/build-catalog.mjs",
		"build:css": "tailwindcss -i src/ui/tailwind.css -o build/plugin-tailwind.css --minify",
		"build:inventory": "npm run build:catalog",
		"build:plugin": "npm run build:catalog && npm run build:css && node scripts/build-plugin.mjs",
		"build:web": "svelte-kit sync && vite build",
		"build": "npm run build:plugin",
		"test": "npm run check",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"deploy:worker:order-fulfillment": "wrangler deploy --config workers/wrangler.order-fulfillment.jsonc",
		"deploy:worker:order-fulfillment:d1": "wrangler deploy --config workers/wrangler.order-fulfillment.d1.jsonc",
		"deploy:worker:order-stock": "wrangler deploy --config workers/wrangler.order-stock.jsonc",
		"deploy:worker:catalog": "wrangler deploy --config workers/wrangler.catalog-d1.jsonc",
		"db:catalog:create": "wrangler d1 create plugin-shop-catalog",
		"db:catalog:migrate": "wrangler d1 migrations apply plugin-shop-catalog --remote --config workers/wrangler.catalog-d1.jsonc",
		"db:catalog:migrate:local": "wrangler d1 migrations apply plugin-shop-catalog --local --config workers/wrangler.catalog-d1.jsonc",
		"db:catalog:demo": "wrangler d1 execute plugin-shop-catalog --remote --file seeds/catalog/products.sql --config workers/wrangler.catalog-d1.jsonc",
		"db:catalog:demo:local": "wrangler d1 execute plugin-shop-catalog --local --file seeds/catalog/products.sql --config workers/wrangler.catalog-d1.jsonc",
		"db:orders:create": "wrangler d1 create plugin-shop-orders",
		"db:orders:migrate": "wrangler d1 migrations apply plugin-shop-orders --remote --config workers/wrangler.order-fulfillment.d1.jsonc",
		"db:orders:migrate:local": "wrangler d1 migrations apply plugin-shop-orders --local --config workers/wrangler.order-fulfillment.d1.jsonc",
		"deploy:orders-db": "npm run db:orders:migrate && npm run deploy:worker:order-fulfillment:d1",
		"deploy:catalog-db": "node scripts/deploy-catalog-db.mjs",
		"deploy:workers": "npm run deploy:worker:order-stock && npm run deploy:worker:order-fulfillment"
	},
	"icon": "icon.svg",
	"permissions": [
		"storage.get",
		"storage.set",
		"storage.remove",
		"events.onPaymentExecuted",
		"network.getJson",
		"network.postJson",
		"payments.openPrefilledPayment",
		"user.getProfile",
		"user.getCoreId",
		"ui.navigate",
		"ui.notify",
		"ui.toast"
	],
	"entry": "default",
	"mota": {
		"infopanel": {
			"description": "Browse shop products and checkout with Wall Money.",
			"primary": {
				"label": "Open shop",
				"href": "/marketplace/wallmoney/plugin-shop"
			},
			"secondary": {
				"label": "Go to cart",
				"href": "/marketplace/wallmoney/plugin-shop?view=cart"
			}
		}
	},
	"bundle": "dist/plugin.js",
	"pluginSrc": [
		"src/config.ts",
		"src/inventory.ts",
		"src/countries.ts",
		"src/state.ts",
		"src/catalog.ts",
		"src/cart.ts",
		"src/ui/shared.ts",
		"src/ui/contact.ts",
		"src/ui/products.ts",
		"src/ui/cart.ts",
		"src/ui/checkout.ts",
		"src/ui/orders.ts",
		"src/ui/success.ts",
		"src/stock.ts",
		"src/email.ts",
		"src/plugin.ts"
	],
	"devDependencies": {
		"@blockchainhub/blo": "^1.2.7",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/cli": "^4.3.1",
		"@types/node": "^24.0.0",
		"lucide-static": "^1.21.0",
		"svelte": "^5.56.0",
		"svelte-check": "^4.5.0",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.104.0"
	},
	"type": "module"
}
